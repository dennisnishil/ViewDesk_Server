{
  "name": "viewdesk-remote-support",
  "version": "1.0.0",
  "description": "ViewDesk Remote Desktop Support Application",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
  "build": "npx tsc",
  "start": "node dist/viewdesk.js",
  "dev": "npx tsx viewdesk.ts",
  "electron:start": "electron .",
  "build:exe": "npm run build && electron-builder --win"
},
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.1.2",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.viewdesk.remotesupport",
    "productName": "ViewDesk",
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "asar": false,
    "directories": {
      "output": "build-dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ViewDesk Remote Support"
    },
    "portable": {
      "requestExecutionLevel": "admin",
      "artifactName": "ViewDesk-Portable.exe"
    }
  }
}
